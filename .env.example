# Model calls (every demo). Any OpenAI-compatible endpoint works; for OpenRouter set
# OPENAI_BASE_URL=https://openrouter.ai/api/v1 and a model such as openai/gpt-4.1-mini.
# The local memory engine also embeds with this key (text-embedding-3-small), so it must reach
# an endpoint that serves embeddings.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# DEMO_MODEL=gpt-4.1-mini

# Hosted Membase (the demos marked "hosted"). A developer key from the app:
# Connect > Developer keys. Leave empty to run every demo on the local engine instead.
MEMBASE_API_KEY=
# MEMBASE_BASE_URL=https://api.app.membase.ai

# Force one mode for every demo: local | hosted. Unset = the demo's own default.
# MEMBASE_DEMO_MODE=
